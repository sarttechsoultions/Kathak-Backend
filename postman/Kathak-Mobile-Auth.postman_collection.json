{
  "info": {
    "_postman_id": "ab71989b-97b6-40b3-bb69-d1a9316676b8",
    "name": "Kathak - Mobile App Authentication",
    "description": "OTP-first mobile signup and shared student login. Signup creates only a student account; enrollment is completed later from the course flow. The contact entered in step 1 is OTP verified. The second contact is collected in step 3 without a second OTP or a password during the current launch flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.kathakbyharshita.com/api/v1" },
    { "key": "mobileEmail", "value": "student.mobile@example.com" },
    { "key": "mobilePhone", "value": "9876543210" },
    { "key": "signupOtp", "value": "001122" },
    { "key": "mobileAccessToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Signup - Send OTP (email or phone)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobileEmail}}\"\n}" },
        "url": "{{baseUrl}}/mobile/auth/signup/send-otp"
      }
    },
    {
      "name": "2. Signup - Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobileEmail}}\",\n  \"code\": \"{{signupOtp}}\"\n}" },
        "url": "{{baseUrl}}/mobile/auth/signup/verify-otp"
      }
    },
    {
      "name": "3. Signup - Complete after email OTP",
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "pm.test('Account was created', () => pm.expect(pm.response.code).to.equal(201));",
        "if (body?.data?.accessToken) pm.collectionVariables.set('mobileAccessToken', body.data.accessToken);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"verifiedIdentifier\": \"{{mobileEmail}}\",\n  \"fullName\": \"Mobile Student\",\n  \"email\": \"{{mobileEmail}}\",\n  \"phone\": \"{{mobilePhone}}\",\n  \"termsAccepted\": true\n}" },
        "url": "{{baseUrl}}/mobile/auth/signup/complete"
      }
    },
    {
      "name": "3b. Signup - Complete after phone OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"verifiedIdentifier\": \"{{mobilePhone}}\",\n  \"countryCode\": \"+91\",\n  \"fullName\": \"Mobile Student\",\n  \"email\": \"{{mobileEmail}}\",\n  \"phone\": \"{{mobilePhone}}\",\n  \"termsAccepted\": true\n}" },
        "url": "{{baseUrl}}/mobile/auth/signup/complete"
      }
    },
    {
      "name": "Student Login - Website or App Account",
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "pm.test('Login succeeds', () => pm.expect(pm.response.code).to.equal(200));",
        "if (body?.data?.accessToken) pm.collectionVariables.set('mobileAccessToken', body.data.accessToken);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{mobileEmail}}\",\n  \"password\": \"{{mobilePassword}}\"\n}" },
        "url": "{{baseUrl}}/mobile/auth/login"
      }
    }
  ]
}
