generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                   @id @default(uuid())
  fullName                   String
  email                      String                   @unique
  phone                      String                   @unique
  passwordHash               String
  role                       Role                     @default(STUDENT)
  avatarUrl                  String?
  country                    String                   @default("India")
  countryCode                String?
  address                    String?
  dob                        DateTime?
  gender                     String?
  city                       String?
  region                     String?
  postalCode                 String?
  skillLevel                 String?
  joiningDate                DateTime?
  isUnder18                  Boolean                  @default(false)
  guardianName               String?
  relationship               String?
  emergencyContact           String?
  paymentMethod              String?
  maritalStatus              String?
  nationality                String?                  @default("Indian")
  languagesKnown             String?
  bankDetails                String[]                 @default([])
  bankAccounts               Json[]                   @default([])
  idProofType                String?
  idProofUrl                 String?
  documents                  Json[]                   @default([])
  notificationPrefs          Json?
  designation                String?
  primaryExpertise           String?
  salaryRate                 String?
  isActive                   Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  assignmentSubmissions      AssignmentSubmission[]
  attendances                Attendance[]
  batchesAsTeacher           Batch[]                  @relation("BatchTeacher")
  batchMemberships           BatchStudent[]
  competitionParticipations  CompetitionParticipant[] @relation("CompetitionParticipant")
  uploadedResources          ContentResource[]        @relation("UploadedResources")
  enrollments                Enrollment[]
  createdEvents              Event[]                  @relation("EventCreator")
  eventsAsInstructor         Event[]                  @relation("EventInstructor")
  eventRegistrations         EventRegistration[]
  createdExams               Exam[]
  examResults                ExamResult[]
  uploadedGalleryItems       GalleryItem[]            @relation("UploadedGalleryItems")
  updatedHeroBanners         HeroBanner[]             @relation("UpdatedHeroBanners")
  inquiries                  Inquiry[]
  updatedLeadPopups          LeadPopup[]              @relation("UpdatedLeadPopups")
  leaveRequests              LeaveRequest[]
  createdLetterheads         Letterhead[]             @relation("CreatedLetterheads")
  notifications              Notification[]
  payments                   Payment[]
  recordedClassViews         RecordedClassView[]
  uploadedStudentCornerItems StudentCornerItem[]      @relation("UploadedStudentCornerItems")
  permissions                TeacherPermission[]
}

model TeacherPermission {
  id         String     @id @default(uuid())
  userId     String
  permission Permission
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Course {
  id                   String          @id @default(uuid())
  title                String
  slug                 String          @unique
  description          String
  thumbnail            String?
  videoUrl             String?
  category             CourseCategory  @default(BASIC)
  groupFeeINR          Float
  groupFeeUSD          Float
  groupClassesCount    String
  oneToOneFeeINR       Float
  oneToOneFeeUSD       Float
  oneToOneClassesCount String
  badgeBgColor         String          @default("#76D7C4")
  borderColor          String          @default("border-[#76D7C4]")
  published            Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  aliases              String[]        @default([])
  homepageSortOrder    Int             @default(0)
  intro                String?
  marketingCategory    String          @default("beginners")
  showExam             Boolean         @default(true)
  showOnHome           Boolean         @default(true)
  batches              Batch[]
  enrollments          Enrollment[]
  exams                Exam[]
  lessons              Lesson[]
  recordedClasses      RecordedClass[]
}

model Lesson {
  id             String   @id @default(uuid())
  courseId       String
  title          String
  description    String?
  orderIndex     Int
  durationSec    Int
  bunnyVideoId   String
  videoLibraryId String
  isFreePreview  Boolean  @default(false)
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Batch {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  courseId         String?
  teacherId        String?
  courseName       String
  level            String            @default("BEGINNER")
  teacherName      String            @default("Unassigned")
  schedule         String?
  totalStudents    Int               @default(0)
  status           String            @default("Active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignments      Assignment[]
  attendances      Attendance[]
  course           Course?           @relation(fields: [courseId], references: [id])
  teacher          User?             @relation("BatchTeacher", fields: [teacherId], references: [id])
  students         BatchStudent[]
  contentResources ContentResource[]
  exams            Exam[]
  liveClasses      LiveClass[]
  recordedClasses  RecordedClass[]
}

model RecordedClass {
  id             String              @id @default(uuid())
  title          String
  description    String?
  videoUrl       String
  thumbnail      String?
  videoId        String?
  duration       String?
  resources      String[]            @default([])
  tags           String[]            @default([])
  isPublic       Boolean             @default(true)
  isDownloadable Boolean             @default(true)
  courseId       String?
  viewsCount     Int                 @default(0)
  batchId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  batch          Batch?              @relation(fields: [batchId], references: [id])
  course         Course?             @relation(fields: [courseId], references: [id])
  viewHistory    RecordedClassView[]
}

model RecordedClassView {
  id              String        @id @default(uuid())
  recordedClassId String
  userId          String
  viewedAt        DateTime      @default(now())
  deviceType      String?
  browser         String?
  ipAddress       String?
  location        String?
  watchTimeSec    Int           @default(0)
  recordedClass   RecordedClass @relation(fields: [recordedClassId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordedClassId, userId])
}

model BatchStudent {
  id        String   @id @default(uuid())
  batchId   String
  studentId String
  createdAt DateTime @default(now())
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String    @id @default(uuid())
  userId    String
  courseId  String
  mode      ClassMode @default(ONLINE)
  type      String    @default("GROUP")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  enrollmentId  String?
  amount        Float
  currency      Currency      @default(INR)
  gateway       String
  transactionId String        @unique
  orderId       String        @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  enrollment    Enrollment?   @relation(fields: [enrollmentId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingEnrollment {
  id              String                  @id @default(uuid())
  email           String
  phone           String
  passwordHash    String
  payload         Json
  batchId         String
  courseId        String
  razorpayOrderId String?                 @unique
  status          PendingEnrollmentStatus @default(PENDING)
  userId          String?
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([email])
  @@index([status])
}

model VerificationOtp {
  id         String    @id @default(uuid())
  channel    String
  target     String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([channel, target])
}

model Inquiry {
  id          String   @id @default(uuid())
  userId      String?
  fullName    String
  contactInfo String
  classMode   String
  subject     String
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  details     Json?
  source      String   @default("SUPPORT")
  user        User?    @relation(fields: [userId], references: [id])

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

model LiveClass {
  id             String                 @id @default(uuid())
  batchId        String
  title          String
  teacherName    String
  scheduledStart DateTime
  scheduledEnd   DateTime
  roomName       String                 @unique
  status         LiveClassStatus        @default(SCHEDULED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  batch          Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chatMessages   LiveClassChatMessage[]

  @@index([batchId, scheduledStart])
}

model LiveClassChatMessage {
  id          String    @id @default(uuid())
  liveClassId String
  senderId    String?
  senderName  String
  text        String
  sentAt      DateTime  @default(now())
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([liveClassId, sentAt])
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  studentName String
  batchId     String?
  batchName   String
  session     String           @default("General")
  date        DateTime         @default(now())
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  batch       Batch?           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([batchId, date, session])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  userId     String
  userName   String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  totalDays  Int
  reason     String
  attachment String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id                 String                 @id @default(uuid())
  batchId            String?
  batchName          String                 @default("All Batches")
  title              String
  description        String
  typeTag            String                 @default("Practical Assessment")
  dueDate            DateTime
  totalPoints        Int                    @default(100)
  referenceFileUrl   String?
  status             String                 @default("ACTIVE")
  teacherId          String?
  teacherName        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  referenceFileName  String?
  evaluationCriteria String?
  batch              Batch?                 @relation(fields: [batchId], references: [id])
  submissions        AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  studentName  String
  fileUrl      String?
  notes        String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?
  feedback     String?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model VideoTask {
  id                   String            @id @default(uuid())
  title                String
  category             String            @default("Kathak")
  course               String            @default("Kathak Advanced")
  batchId              String?
  batchName            String            @default("Alpha-2024")
  priority             PriorityLevel     @default(Low)
  submissionDate       DateTime
  cutOffTime           String            @default("18:00")
  strictDeadline       Boolean           @default(false)
  detailedInstructions String?
  referenceFileUrl     String?
  creatorRole          Role              @default(ADMIN)
  createdById          String?
  createdByName        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  videoSubmissions     VideoSubmission[]
}

model VideoSubmission {
  id               String                @id @default(uuid())
  taskId           String?
  studentId        String
  studentName      String
  studentAvatar    String?
  studentBatch     String                @default("Alpha-2024")
  submissionDate   DateTime              @default(now())
  courseAndBatch   String                @default("Kathak Foundations • #402")
  videoTitle       String
  fileUrl          String?
  status           VideoSubmissionStatus @default(PENDING)
  marks            Float?
  feedbackNotes    String?
  correctionNotes  String[]              @default([])
  evaluationRubric Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  task             VideoTask?            @relation(fields: [taskId], references: [id])
}

model Exam {
  id            String       @id @default(uuid())
  title         String
  description   String?
  examCode      String       @unique
  type          ExamType     @default(THEORY)
  date          DateTime
  durationMins  Int          @default(120)
  totalMarks    Float        @default(100)
  passingMarks  Float        @default(40)
  status        ExamStatus   @default(SCHEDULED)
  questionsData Json?
  batchId       String?
  courseId      String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  batch         Batch?       @relation(fields: [batchId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
  createdBy     User?        @relation(fields: [createdById], references: [id])
  results       ExamResult[]
}

model ExamResult {
  id                  String   @id @default(uuid())
  examId              String
  studentId           String
  marksObtained       Float?
  grade               String?
  status              String   @default("PENDING")
  feedback            String?
  fileUrl             String?
  submittedAt         DateTime @default(now())
  answersData         Json?
  flagged             Boolean  @default(false)
  questionEvaluations Json?
  exam                Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model Event {
  id               String              @id @default(uuid())
  title            String
  category         EventCategory       @default(Workshop)
  description      String
  startDate        DateTime            @db.Date
  endDate          DateTime            @db.Date
  startTime        String
  durationMins     Int                 @default(60)
  leadInstructorId String?
  capacity         Int
  level            EventLevel          @default(Beginner)
  registrationFee  Float               @default(0.0)
  locationOrLink   String
  status           EventStatus         @default(DRAFT)
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  isFeatured       Boolean             @default(false)
  badgeTag         String?
  bannerImage      String?
  thumbnailImage   String?
  createdBy        User?               @relation("EventCreator", fields: [createdById], references: [id])
  leadInstructor   User?               @relation("EventInstructor", fields: [leadInstructorId], references: [id])
  registrations    EventRegistration[]
  tickets          EventTicket[]
}

model EventRegistration {
  id            String        @id @default(uuid())
  eventId       String
  studentId     String
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  registeredAt  DateTime      @default(now())
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
}

model EventTicket {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  eventId           String
  fullName          String
  email             String
  phone             String
  city              String        @default("")
  quantity          Int           @default(1)
  amount            Float         @default(0)
  paymentMethod     String?
  paymentStatus     PaymentStatus @default(PENDING)
  ticketEmail       String
  createdAt         DateTime      @default(now())
  adultCount        Int           @default(0)
  childCount        Int           @default(0)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  event             Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
}

model Competition {
  id           String                   @id @default(uuid())
  title        String
  status       String                   @default("ACTIVE")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  participants CompetitionParticipant[]
  updates      CompetitionUpdate[]
}

model CompetitionParticipant {
  id              String      @id @default(uuid())
  competitionId   String
  studentId       String
  performanceSlot DateTime?
  stageLocation   String?
  createdAt       DateTime    @default(now())
  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student         User        @relation("CompetitionParticipant", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([competitionId, studentId])
}

model CompetitionUpdate {
  id            String      @id @default(uuid())
  competitionId String
  title         String
  description   String
  dueDate       DateTime?
  timeLabel     String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model Offer {
  id              String    @id @default(uuid())
  badgeLabel      String
  title           String
  description     String
  ctaLabel        String    @default("Claim Offer")
  ctaLink         String?
  discountPercent Int?
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isUnread  Boolean  @default(true)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentResource {
  id           String       @id @default(uuid())
  title        String
  description  String?
  type         ResourceType @default(DOCUMENT)
  fileUrl      String
  category     String       @default("General")
  isGlobal     Boolean      @default(true)
  batchId      String?
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  batch        Batch?       @relation(fields: [batchId], references: [id])
  uploadedBy   User         @relation("UploadedResources", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([batchId])
}

model GalleryItem {
  id              String           @id @default(uuid())
  title           String
  altText         String?
  category        GalleryCategory
  mediaType       GalleryMediaType
  url             String
  thumbnailUrl    String?
  showOnHome      Boolean          @default(true)
  sortOrder       Int              @default(0)
  fileName        String?
  fileSize        String?
  uploadedById    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  journeyCarousel Boolean          @default(false)
  uploadedBy      User             @relation("UploadedGalleryItems", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([showOnHome])
  @@index([sortOrder])
  @@index([createdAt])
}

model JourneyCarouselSettings {
  id                 String   @id @default("journey-carousel")
  intervalMs         Int      @default(1000)
  transition         String   @default("fade")
  transitionDuration Int      @default(500)
  updatedAt          DateTime @updatedAt
}

model JourneyCarouselItem {
  id        String   @id @default(uuid())
  title     String
  altText   String?
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroBanner {
  id                String        @id @default(uuid())
  pageKey           HeroPage      @unique
  title             String
  highlight         String?
  subtitle          String        @default("")
  tagline           String?
  mediaType         HeroMediaType @default(IMAGE)
  mediaUrl          String
  imageAlt          String?
  ctaLabel          String?
  ctaLink           String?
  ctaSecondaryLabel String?
  ctaSecondaryLink  String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  ctaAction         String?       @default("LINK")
  ctaColor          String?       @default("#9E0C25")
  ctaLayout         String?       @default("SOLID")
  ctaPosition       String?       @default("CENTER")
  ctaBorderRadius   String?       @default("FULL")
  updatedBy         User?         @relation("UpdatedHeroBanners", fields: [updatedById], references: [id])

  @@index([pageKey])
}

model LeadPopup {
  id           String   @id @default("default")
  isEnabled    Boolean  @default(true)
  delaySeconds Int      @default(300)
  title        String   @default("Get in Touch")
  subtitle     String   @default("Start Your Kathak Journey With Us")
  imageUrl     String
  imageAlt     String   @default("Kathak dancer")
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    User?    @relation("UpdatedLeadPopups", fields: [updatedById], references: [id])
}

model DemoSettings {
  id                   String   @id @default("default")
  oneToOneFeeINR       Float    @default(499)
  oneToOneDurationMins Int      @default(45)
  isOneToOneEnabled    Boolean  @default(true)
  isGroupEnabled       Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model DemoGroupSession {
  id           String        @id @default(uuid())
  title        String
  startsAt     DateTime
  durationMins Int           @default(60)
  classMode    String        @default("Online")
  capacity     Int           @default(20)
  location     String        @default("")
  notes        String        @default("")
  isPublished  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     DemoBooking[]

  @@index([startsAt])
  @@index([isPublished])
}

model DemoBooking {
  id                String            @id @default(uuid())
  type              DemoClassType
  status            DemoBookingStatus @default(PENDING)
  fullName          String
  email             String
  phone             String
  course            String
  classMode         String
  message           String            @default("")
  preferredDate     DateTime?
  preferredTime     String?
  sessionId         String?
  amount            Float             @default(0)
  paymentStatus     PaymentStatus     @default(PENDING)
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  session           DemoGroupSession? @relation(fields: [sessionId], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model StudentCornerItem {
  id           String            @id @default(uuid())
  kind         StudentCornerKind
  studentName  String
  level        String
  description  String            @default("")
  duration     String?
  videoUrl     String
  thumbnailUrl String?
  sortOrder    Int               @default(0)
  isPublished  Boolean           @default(true)
  fileName     String?
  fileSize     String?
  uploadedById String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  uploadedBy   User              @relation("UploadedStudentCornerItems", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([kind])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([createdAt])
}

model LetterheadTemplate {
  id          String       @id @default(uuid())
  name        String
  imageUrl    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  letterheads Letterhead[]

  @@index([isActive])
  @@index([createdAt])
}

model Letterhead {
  id          String             @id @default(uuid())
  title       String
  contentHtml String
  fontFamily  String             @default("Georgia, serif")
  isDefault   Boolean            @default(false)
  usageCount  Int                @default(0)
  templateId  String
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  pagesJson   Json?
  createdBy   User?              @relation("CreatedLetterheads", fields: [createdById], references: [id])
  template    LetterheadTemplate @relation(fields: [templateId], references: [id])

  @@index([isDefault])
  @@index([updatedAt])
  @@index([templateId])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Permission {
  VIEW_DASHBOARD
  MANAGE_COURSES
  VIEW_COURSES
  CREATE_COURSE
  EDIT_COURSE
  DELETE_COURSE
  MANAGE_STUDENTS
  VIEW_STUDENTS
  CREATE_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT
  MANAGE_TEACHERS
  VIEW_TEACHERS
  CREATE_TEACHER
  EDIT_TEACHER
  DELETE_TEACHER
  MANAGE_BATCHES
