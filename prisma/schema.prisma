datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Permission {
  VIEW_DASHBOARD
  
  MANAGE_COURSES
  VIEW_COURSES
  CREATE_COURSE
  EDIT_COURSE
  DELETE_COURSE

  MANAGE_STUDENTS
  VIEW_STUDENTS
  CREATE_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT

  MANAGE_TEACHERS
  VIEW_TEACHERS
  CREATE_TEACHER
  EDIT_TEACHER
  DELETE_TEACHER

  MANAGE_BATCHES
  VIEW_BATCHES
  CREATE_BATCH
  EDIT_BATCH
  DELETE_BATCH

  MANAGE_ASSIGNMENTS
  VIEW_ASSIGNMENTS
  CREATE_ASSIGNMENT
  GRADE_ASSIGNMENT

  MANAGE_CLASSES
  VIEW_CLASSES
  START_LIVE_CLASS

  MANAGE_RECORDED_CLASSES
  UPLOAD_RECORDED_CLASS

  MANAGE_VIDEO_REVIEWS
  VIEW_VIDEO_REVIEWS
  EVALUATE_VIDEO_REVIEW

  MANAGE_EXAMS
  VIEW_EXAMS
  CREATE_EXAM
  GRADE_EXAMS

  VIEW_EXAM_RESULTS

  MANAGE_ATTENDANCE
  VIEW_ATTENDANCE
  MARK_ATTENDANCE

  MANAGE_EVENTS
  VIEW_EVENTS

  MANAGE_COMMUNICATION
  VIEW_COMMUNICATION
  SEND_COMMUNICATION

  MANAGE_CONTENT_LIBRARY
  VIEW_PAYMENTS
  MANAGE_WEBSITE
  VIEW_ANALYTICS
  MANAGE_CERTIFICATES
  ISSUE_CERTIFICATE
  MANAGE_SETTINGS
  MANAGE_SUPPORT
  ANSWER_SUPPORT
  MANAGE_INQUIRIES
  MANAGE_GALLERY
  MANAGE_REVIEWS
}

enum ClassMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseCategory {
  BASIC
  INTERMEDIATE
  PREMIUM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Currency {
  INR
  USD
  GBP
  EUR
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  country      String   @default("India")
  countryCode  String?
  address      String?

  dob              DateTime?
  gender           String?
  city             String?
  region           String?
  postalCode       String?
  skillLevel       String?
  joiningDate      DateTime?
  isUnder18        Boolean   @default(false)
  guardianName     String?
  relationship     String?
  emergencyContact String?
  paymentMethod    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions           TeacherPermission[]
  enrollments           Enrollment[]
  inquiries             Inquiry[]
  payments              Payment[]
  attendances           Attendance[]
  batchMemberships      BatchStudent[]
  assignmentSubmissions AssignmentSubmission[]
}

model TeacherPermission {
  id          String     @id @default(uuid())
  userId      String
  permission  Permission

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Course {
  id                    String         @id @default(uuid())
  title                 String
  slug                  String         @unique
  description           String
  category              CourseCategory @default(BASIC)
  groupFeeINR           Float
  groupFeeUSD           Float
  groupClassesCount     String
  oneToOneFeeINR        Float
  oneToOneFeeUSD        Float
  oneToOneClassesCount  String
  badgeBgColor          String         @default("#76D7C4")
  borderColor           String         @default("border-[#76D7C4]")
  published             Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  enrollments           Enrollment[]
  lessons               Lesson[]
  batches               Batch[]
}

model Lesson {
  id             String    @id @default(uuid())
  courseId       String
  title          String
  description    String?
  orderIndex     Int
  durationSec    Int
  bunnyVideoId   String
  videoLibraryId String
  isFreePreview  Boolean   @default(false)
  createdAt      DateTime  @default(now())

  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Batch {
  id            String       @id @default(uuid())
  name          String
  code          String       @unique
  courseId      String?
  courseName    String
  level         String       @default("ADVANCED")
  teacherName   String       @default("Arjun Sharma")
  schedule      String
  totalStudents Int          @default(0)
  status        String       @default("Active")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  course        Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  students      BatchStudent[]
  attendances   Attendance[]
  liveClasses   LiveClass[]
  assignments   Assignment[]
}

model BatchStudent {
  id        String   @id @default(uuid())
  batchId   String
  studentId String
  createdAt DateTime @default(now())

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
}

model Enrollment {
  id           String    @id @default(uuid())
  userId       String
  courseId     String
  mode         ClassMode @default(ONLINE)
  type         String    @default("GROUP")
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments     Payment[]
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  enrollmentId   String?
  amount         Float
  currency       Currency      @default(INR)
  gateway        String
  transactionId  String        @unique
  orderId        String        @unique
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
}

model Inquiry {
  id           String   @id @default(uuid())
  userId       String?
  fullName     String
  contactInfo  String
  classMode    String
  subject      String
  message      String
  status       String   @default("NEW")
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model LiveClass {
  id             String          @id @default(uuid())
  batchId        String
  title          String
  teacherName    String
  scheduledStart DateTime
  scheduledEnd   DateTime
  roomName       String          @unique
  status         LiveClassStatus @default(SCHEDULED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  batch          Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, scheduledStart])
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  studentName String
  batchId     String?
  batchName   String
  session     String           @default("General")
  date        DateTime         @default(now())
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch       Batch?           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, date, session])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

model Assignment {
  id               String   @id @default(uuid())
  batchId          String?
  batchName        String   @default("All Batches")
  title            String
  description      String
  typeTag          String   @default("Practical Assessment")
  dueDate          DateTime
  totalPoints      Int      @default(100)
  referenceFileUrl String?
  status           String   @default("ACTIVE")

  // Teacher fields
  teacherId        String?
  teacherName      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batch            Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  submissions      AssignmentSubmission[]

  // Optional: relation to User
  // teacher         User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  studentName  String
  fileUrl      String?
  notes        String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?
  feedback     String?

  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}
