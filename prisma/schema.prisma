datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Permission {
  VIEW_DASHBOARD

  MANAGE_COURSES
  VIEW_COURSES
  CREATE_COURSE
  EDIT_COURSE
  DELETE_COURSE

  MANAGE_STUDENTS
  VIEW_STUDENTS
  CREATE_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT

  MANAGE_TEACHERS
  VIEW_TEACHERS
  CREATE_TEACHER
  EDIT_TEACHER
  DELETE_TEACHER

  MANAGE_BATCHES
  VIEW_BATCHES
  CREATE_BATCH
  EDIT_BATCH
  DELETE_BATCH

  MANAGE_ASSIGNMENTS
  VIEW_ASSIGNMENTS
  CREATE_ASSIGNMENT
  GRADE_ASSIGNMENT

  MANAGE_CLASSES
  VIEW_CLASSES
  START_LIVE_CLASS

  MANAGE_RECORDED_CLASSES
  UPLOAD_RECORDED_CLASS

  MANAGE_VIDEO_REVIEWS
  VIEW_VIDEO_REVIEWS
  EVALUATE_VIDEO_REVIEW

  MANAGE_EXAMS
  VIEW_EXAMS
  CREATE_EXAM
  GRADE_EXAMS

  VIEW_EXAM_RESULTS

  MANAGE_ATTENDANCE
  VIEW_ATTENDANCE
  MARK_ATTENDANCE

  MANAGE_EVENTS
  VIEW_EVENTS

  MANAGE_COMMUNICATION
  VIEW_COMMUNICATION
  SEND_COMMUNICATION

  MANAGE_CONTENT_LIBRARY
  VIEW_PAYMENTS
  MANAGE_WEBSITE
  VIEW_ANALYTICS
  MANAGE_CERTIFICATES
  ISSUE_CERTIFICATE
  MANAGE_SETTINGS
  MANAGE_SUPPORT
  ANSWER_SUPPORT
  MANAGE_INQUIRIES
  MANAGE_GALLERY
  MANAGE_REVIEWS
}

enum ClassMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseCategory {
  BASIC
  INTERMEDIATE
  PREMIUM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Currency {
  INR
  USD
  GBP
  EUR
}

model User {
  id           String  @id @default(uuid())
  fullName     String
  email        String  @unique
  phone        String  @unique
  passwordHash String
  role         Role    @default(STUDENT)
  avatarUrl    String?
  country      String  @default("India")
  countryCode  String?
  address      String?

  dob              DateTime?
  gender           String?
  city             String?
  region           String?
  postalCode       String?
  skillLevel       String?
  joiningDate      DateTime?
  isUnder18        Boolean   @default(false)
  guardianName     String?
  relationship     String?
  emergencyContact String?
  paymentMethod    String?

  maritalStatus    String?
  nationality      String?   @default("Indian")
  languagesKnown   String?
  
  // Legacy bank Details
  bankDetails      String[]  @default([])
  // New Structured Bank Accounts
  bankAccounts     Json[]    @default([])
  
  // Legacy ID Proof
  idProofType      String?
  idProofUrl       String?
  // New Multiple Documents
  documents        Json[]    @default([])

  designation      String?
  primaryExpertise String?
  salaryRate       String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions           TeacherPermission[]
  enrollments           Enrollment[]
  inquiries             Inquiry[]
  payments              Payment[]
  attendances           Attendance[]
  batchMemberships      BatchStudent[]
  assignmentSubmissions AssignmentSubmission[]
  batchesAsTeacher      Batch[]                @relation("BatchTeacher")
  recordedClassViews RecordedClassView[]
  createdExams          Exam[]
  examResults            ExamResult[]
}

model TeacherPermission {
  id         String     @id @default(uuid())
  userId     String
  permission Permission

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Course {
  id                   String         @id @default(uuid())
  title                String
  slug                 String         @unique
  description          String
  thumbnail            String?
  videoUrl             String?
  category             CourseCategory @default(BASIC)
  groupFeeINR          Float
  groupFeeUSD          Float
  groupClassesCount    String         // Perfect: Store "10 classes per month" etc.
  oneToOneFeeINR       Float
  oneToOneFeeUSD       Float
  oneToOneClassesCount String         // Perfect: Store "Minimum 4 classes per month"
  badgeBgColor         String         @default("#76D7C4")
  borderColor          String         @default("border-[#76D7C4]")
  published            Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  recordedClasses RecordedClass[]
  enrollments Enrollment[]
  lessons     Lesson[]
  batches     Batch[]
  exams        Exam[]
}

model Lesson {
  id             String   @id @default(uuid())
  courseId       String
  title          String
  description    String?
  orderIndex     Int
  durationSec    Int
  bunnyVideoId   String
  videoLibraryId String
  isFreePreview  Boolean  @default(false)
  createdAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Batch {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  courseId      String?  
  teacherId     String?
  courseName    String
  level         String   @default("BEGINNER") // Ya isko default hatakar required kar dein
  teacherName   String   @default("Unassigned") // "Arjun Sharma" ki jagah "Unassigned" best hai
  schedule      String?  // Isko optional (?) kar dein taaki bina schedule ke bhi batch ban sake
  totalStudents Int      @default(0)
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher     User?          @relation("BatchTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  students    BatchStudent[]
  attendances Attendance[]
  liveClasses LiveClass[]
  recordedClasses RecordedClass[]
  assignments Assignment[]
  exams        Exam[]
}


model RecordedClass {
  id             String   @id @default(uuid())
  title          String
  description    String?
  videoUrl       String
  thumbnail      String?
  videoId        String?
  duration       String?
  resources      String[] @default([])
  tags           String[] @default([])
  isPublic       Boolean  @default(true)
  isDownloadable Boolean  @default(true)

  courseId       String?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  viewsCount      Int                 @default(0) // Cache for quick total views
  viewHistory     RecordedClassView[] // Relation to tracking table
  batchId        String?
  batch          Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RecordedClassView {
  id              String        @id @default(uuid())
  recordedClassId String
  userId          String
  viewedAt        DateTime      @default(now())
  deviceType      String?       // "Mobile", "Desktop", "Tablet"
  browser         String?       // "Chrome", "Safari"
  ipAddress       String?       // "103.11.22.33"
  location        String?       // "Kanpur, Uttar Pradesh, India"
  watchTimeSec    Int           @default(0) // Kitne seconds video dekhi

  recordedClass   RecordedClass @relation(fields: [recordedClassId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordedClassId, userId])
}

model BatchStudent {
  id        String   @id @default(uuid())
  batchId   String
  studentId String
  createdAt DateTime @default(now())

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String    @id @default(uuid())
  userId    String
  courseId  String
  mode      ClassMode @default(ONLINE)
  type      String    @default("GROUP")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  enrollmentId  String?
  amount        Float
  currency      Currency      @default(INR)
  gateway       String
  transactionId String        @unique
  orderId       String        @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
}

model Inquiry {
  id          String   @id @default(uuid())
  userId      String?
  fullName    String
  contactInfo String
  classMode   String
  subject     String
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model LiveClass {
  id             String          @id @default(uuid())
  batchId        String
  title          String
  teacherName    String
  scheduledStart DateTime
  scheduledEnd   DateTime
  roomName       String          @unique
  status         LiveClassStatus @default(SCHEDULED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, scheduledStart])
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  studentName String
  batchId     String?
  batchName   String
  session     String           @default("General")
  date        DateTime         @default(now())
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, date, session])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

model Assignment {
  id               String   @id @default(uuid())
  batchId          String?
  batchName        String   @default("All Batches")
  title            String
  description      String
  typeTag          String   @default("Practical Assessment")
  dueDate          DateTime
  totalPoints      Int      @default(100)
  referenceFileUrl String?
  status           String   @default("ACTIVE")

  // Teacher fields
  teacherId   String?
  teacherName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch       Batch?                 @relation(fields: [batchId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  // Optional: relation to User
  // teacher         User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  studentName  String
  fileUrl      String?
  notes        String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

enum VideoSubmissionStatus {
  PENDING
  REVIEWED
  NEEDS_IMPROVEMENT
}

enum PriorityLevel {
  Low
  Medium
  High
}

model VideoTask {
  id                   String        @id @default(uuid())
  title                String
  category             String        @default("Kathak")
  course               String        @default("Kathak Advanced")
  batchId              String?
  batchName            String        @default("Alpha-2024")
  priority             PriorityLevel @default(Low)
  submissionDate       DateTime
  cutOffTime           String        @default("18:00")
  strictDeadline       Boolean       @default(false)
  detailedInstructions String?
  referenceFileUrl     String?

  creatorRole   Role    @default(ADMIN)
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoSubmissions VideoSubmission[]
}

model VideoSubmission {
  id               String                @id @default(uuid())
  taskId           String?
  studentId        String
  studentName      String
  studentAvatar    String?
  studentBatch     String                @default("Alpha-2024")
  submissionDate   DateTime              @default(now())
  courseAndBatch   String                @default("Kathak Foundations • #402")
  videoTitle       String
  fileUrl          String?
  status           VideoSubmissionStatus @default(PENDING)
  marks            Float?
  feedbackNotes    String?
  correctionNotes  String[]              @default([])
  evaluationRubric Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task VideoTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}
// ================= EXAM MANAGEMENT =================

enum ExamType {
  THEORY
  PRACTICAL
  VIVA
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Exam {
  id            String     @id @default(uuid())
  title         String
  description   String?    // Extra instructions or JSON payload
  examCode      String     @unique
  type          ExamType   @default(THEORY)
  date          DateTime   // Scheduled date and start time
  durationMins  Int        @default(120)
  totalMarks    Float      @default(100)
  passingMarks  Float      @default(40)
  status        ExamStatus @default(SCHEDULED)
  questionsData  Json?

  // Relations
  batchId       String?
  batch         Batch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  courseId      String?
  course        Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // Tracker for who created it (Admin or Teacher)
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  results       ExamResult[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model ExamResult {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Float?
  grade         String?
  status        String   @default("PENDING") // PASS, FAIL, PENDING
  feedback      String?
  fileUrl       String?  // If they need to upload a video/document for practicals
  submittedAt   DateTime @default(now())
  answersData    Json?

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId]) // Ek student ek exam ek hi baar de sakta hai
}